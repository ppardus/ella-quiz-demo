datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model QuizSet {
  id             String   @id @default(cuid())
  targetLanguage String
  knownLanguage  String
  level          String
  createdAt      DateTime @default(now())
  metadata       Json?
  quizzes        Quiz[]
}

model Quiz {
  id                  String   @id @default(cuid())
  quizSetId           String
  quizSet             QuizSet  @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
  word                String
  sentenceTarget      String
  sentenceKnownMasked String
  // SQLite can't store scalar lists; use Json for the options array:
  optionsKnown        Json
  correctIndex        Int
  slug                String   @unique
  indexInSet          Int
  createdAt           DateTime @default(now())

  // back relation for answers:
  answers QuizAnswer[]
}

model QuizAnswer {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choiceIndex Int?
  isCorrect   Boolean?
  action      String // "answered" | "skipped"
  timeMs      Int?
  createdAt   DateTime @default(now())
}
